{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "description": "John's local ICE: Ollama, offline speech and approved Windows tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build --configLoader native",
    "lint": "node node_modules/oxlint/bin/oxlint src bridge/local bridge/local-server.mjs tests scripts",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
