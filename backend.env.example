# Backend only. Copy to backend.env; never prefix credentials with VITE_.
# Local default:
# JARVIS_PROVIDER=ollama
# JARVIS_MODEL=qwen3:4b
OLLAMA_HOST=http://127.0.0.1:11434
# Laptop-safe defaults are also sent per chat (num_ctx 2048, num_gpu 0, 4 threads).

# Google Gemini (AI Studio). Put the real key only in backend.env.
# JARVIS_PROVIDER=gemini
# JARVIS_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL=
# GEMINI_API_KEY=
# If Gemini is busy (HTTP 503) or returns 400/404, ICE retries other Gemini Flash models, then Groq, then Grok (xAI), then local qwen3:4b.
# Last working Gemini model is stored as GEMINI_MODEL. There is no Claude failover.
GROQ_API_KEY=
XAI_API_KEY=
GROK_API_KEY=

# Optional other hosted adapter. No provider/model is assumed free.
# JARVIS_PROVIDER=openai-compatible
# JARVIS_CLOUD_ENABLED=1
# JARVIS_CLOUD_URL=https://your-provider.example/v1
# JARVIS_CLOUD_MODEL=your-verified-model-id
# JARVIS_CLOUD_KEY=your-key
# Selected memory/profile is not sent to cloud unless explicitly enabled below.
# JARVIS_SHARE_MEMORY=1
